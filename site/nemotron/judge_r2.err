  $ # Check for unclosed tags and structure
python3 -c "
import re
html = open('/Users/yuki/workspace/cagent/site/nemotron/index.html').read()

# Check DOCTYPE
print('DOCTYPE present:', '<!DOCTYPE html>' in html)

# Check lang attribute
print('lang=ja:', 'lang=\"ja\"' in html)

# Check viewport
print('viewport meta:', 'viewport' in html)

# Check charset
print('charset:', 'charset' in html)

# Check meta description
print('meta description:', 'name=\"description\"' in html)

# Check skip-link
print('skip-link:', 'skip-link' in html)

# Check semantic tags
print('header:', '<header>' in html)
print('main:', '<main' in html)
print('footer:', '<footer>' in html)
print('section:', '<section' in html)

# Check aria labels
print('aria-label:', 'aria-label' in html)

# Check h1-h6 hierarchy
h_tags = re.findall(r'<h(\d)', html)
print('h tags:', h_tags)

# Check if script is properly closed
print('script closed:', '</script>' in html)
print('style closed:', '</style>' in html)
print('html closed:', '</html>' in html)
"

